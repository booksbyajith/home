---
import { l10nText as tl } from '@shared/l10n';
import type { Lang } from '@shared/constants';
import AuthorReveal from '../components/AuthorReveal.astro';
import Cover from '../components/Cover.astro';
import PostCard from '../components/PostCard.astro';
import Slideshow from '../components/Slideshow.astro';
import NewsletterForm from '../islands/forms/NewsletterForm';
import SocialSection from '../components/SocialSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, pick, useT } from '../i18n';
import { getBookText, getBooks, getLatest } from '../lib/content';
import { absUrl, href } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const books = await getBooks();
const featured = books.find((b) => b.featured) ?? books[0];
const featuredText = await getBookText(featured.slug, lang);
const latest = await getLatest(lang, 3);
const front = featured.covers.find((c) => c.kind === 'front')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t('site.name'),
  url: absUrl(href(lang, '/')),
  inLanguage: lang,
};
const authorIntro = {
  si: 'වෘත්තියෙන් වෛද්‍ය විශේෂඥයෙකු වන වෛද්‍ය අජිත් අමරසිංහ ශ්‍රී ලංකා රාජකීය ආසියාතික සංගමයේ සාමාජිකයෙකු සහ ඓතිහාසික පර්යේෂණ කෘති තුනක කතුවරයා වේ.',
  en: 'A medical specialist by profession, Dr. Ajith Amarasinghe is a member of the Royal Asiatic Society of Sri Lanka and the author of three historical research works.',
  ta: 'தொழில்ரீதியாக மருத்துவ நிபுணரான வைத்தியர் அஜித் அமரசிங்க, இலங்கை ராயல் ஆசியச் சங்கத்தின் உறுப்பினரும் மூன்று வரலாற்று ஆய்வு நூல்களின் ஆசிரியருமாவார்.',
}[lang];
---

<BaseLayout
  lang={lang}
  title={t('site.name')}
  description={`${t('site.tagline')}. ${authorIntro}`}
  jsonLd={jsonLd}
>
  <section class="relative overflow-x-clip" aria-labelledby="hero-h">
    <div class="container-page grid items-center gap-8 pt-8 pb-10 lg:grid-cols-[1fr_1fr] lg:gap-6 lg:pt-14 lg:pb-16">
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <p class="eyebrow enter">{t('site.tagline')}</p>
        <h1 id="hero-h" class="display-xl enter enter-1 mt-3 text-ink">
          {t('site.name')}
        </h1>
        <p class="enter enter-2 mx-auto mt-5 max-w-xl text-lg text-ink-soft lg:mx-0">{authorIntro}</p>
        <p class="enter enter-3 mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href={href(lang, `/order/?book=${featured.slug}`)} class="btn-primary">
            {t('home.featured.orderNow')}
          </a>
          <a href="#books" class="btn-secondary">
            {t('home.hero.explore')}
          </a>
        </p>
        <a
          href={href(lang, `/books/${featured.slug}/`)}
          class="enter enter-4 group mt-10 inline-flex items-center gap-3 rounded-full border border-line bg-card/80 py-1.5 pr-4 pl-1.5 text-left text-ink no-underline shadow-sm transition hover:border-maroon/50"
        >
          <span class="block h-11 w-8 shrink-0 overflow-hidden rounded-sm">
            <Cover path={`/covers/${front.file}`} alt="" sizes="32px" class="h-full w-full object-cover" />
          </span>
          <span class="text-sm leading-snug">
            <span class="block font-semibold text-gold">{t('home.featured.title')}</span>
            <span class="block font-semibold group-hover:text-maroon">{tl(featured.title, lang)}</span>
          </span>
        </a>
      </div>
      <div class="order-1 lg:order-2">
        <AuthorReveal lang={lang} />
      </div>
    </div>
  </section>

  <section
    id="books"
    class="scroll-mt-24 border-y border-line/70 bg-paper-dark/60 py-16"
    aria-labelledby="books-h"
  >
    <div class="container-page text-center" data-reveal>
      <p class="eyebrow">{t('site.tagline')}</p>
      <h2 id="books-h" class="display-lg mt-2">
        {t('books.title')}
      </h2>
      <p class="ornament mx-auto mt-4 max-w-xs text-2xl leading-none" aria-hidden="true">
        ෴
      </p>
    </div>
    <div class="mt-8">
      <Slideshow lang={lang} books={books} />
    </div>
  </section>

  <section class="container-page mt-20" aria-labelledby="featured-h" data-reveal>
    <div class="card relative grid items-center gap-8 overflow-hidden p-6 md:grid-cols-[240px_1fr] md:p-10">
      <div
        class="pointer-events-none absolute -top-16 -right-16 h-56 w-56 rounded-full border border-gold/30"
        aria-hidden="true"
      ></div>
      <Cover
        path={`/covers/${front.file}`}
        alt={tl(front.alt, lang)}
        sizes="240px"
        class="mx-auto w-44 -rotate-2 rounded-md shadow-2xl transition-transform duration-500 hover:rotate-0 md:w-full"
      />
      <div class="relative">
        <p class="eyebrow">{t('home.featured.title')}</p>
        <h2 id="featured-h" class="display-md mt-2">
          {tl(featured.title, lang)}
        </h2>
        {featured.launch && (
          <p class="mt-3 text-ink-soft">
            {t('home.featured.launched', {
              date: formatDate(lang, featured.launch.date),
              venue: tl(featured.launch.venue, lang),
            })}
          </p>
        )}
        {featuredText && <p class="mt-4 text-lg">{featuredText.data.summary}</p>}
        <p class="mt-6 flex flex-wrap gap-3">
          <a href={href(lang, `/order/?book=${featured.slug}`)} class="btn-primary" data-featured-order>
            {t('home.featured.orderNow')}
          </a>
          <a href={href(lang, `/books/${featured.slug}/`)} class="btn-secondary">
            {t('home.featured.details')}
          </a>
        </p>
      </div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="container-page mt-24" aria-labelledby="latest-h">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="eyebrow">{t('nav.news')}</p>
          <h2 id="latest-h" class="display-lg mt-2">
            {t('home.latest.title')}
          </h2>
        </div>
        <a href={href(lang, '/news/')} class="btn-secondary">
          {t('home.latest.all')} →
        </a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {latest.map(({ kind, post }) => (
          <div data-reveal>
            <PostCard lang={lang} kind={kind} post={post} headingLevel="h3" />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="container-page mt-24" aria-labelledby="author-h">
    <div class="grid items-center gap-10 md:grid-cols-[minmax(0,340px)_1fr] md:gap-14">
      <div class="relative mx-auto w-64 md:w-full" data-reveal>
        <div class="absolute -inset-3 rounded-t-full border border-gold/50" aria-hidden="true"></div>
        <Cover
          path="/author/author-portrait.jpg"
          alt={t('pressKit.photo')}
          sizes="(min-width: 768px) 340px, 256px"
          class="relative aspect-[4/5] w-full rounded-t-full object-cover object-top shadow-xl"
        />
      </div>
      <div data-reveal>
        <p class="eyebrow">{t('nav.about')}</p>
        <h2 id="author-h" class="display-lg mt-2">
          {t('home.author.title')}
        </h2>
        <p class="mt-5 text-lg">{authorIntro}</p>
        <p class="mt-8 flex flex-wrap items-center gap-3">
          <a href={href(lang, '/about/')} class="btn-primary">
            {t('home.author.more')}
          </a>
          <a href="#" data-config="facebook" hidden target="_blank" rel="noopener" class="btn-secondary">
            {t('footer.facebook')} ↗
          </a>
        </p>
      </div>
    </div>
  </section>

  <SocialSection lang={lang} />

  <section class="container-page mt-24" aria-labelledby="news-h" data-reveal>
    <div class="relative overflow-hidden rounded-3xl bg-maroon-dark px-6 py-10 text-paper md:px-12 md:py-14">
      <div class="letters-map pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center">
        <div>
          <p class="eyebrow text-gold-light">{t('footer.newsletter')}</p>
          <h2 id="news-h" class="display-md mt-2 text-paper">
            {t('home.newsletter.title')}
          </h2>
          <p class="mt-3 text-paper/85">{t('home.newsletter.blurb')}</p>
        </div>
        <div class="rounded-2xl bg-paper p-5 text-ink shadow-xl">
          <NewsletterForm
            client:visible
            lang={lang}
            dict={pick(lang, ['newsletter.', 'form.'])}
            source="home"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .letters-map {
    background: url('../assets/map-bg.svg') no-repeat left -60px center / 420px auto;
    opacity: 0.1;
    filter: invert(1);
  }
</style>
