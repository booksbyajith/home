---
import type { Lang } from '@shared/constants';
import SuccessApp from '../islands/order/SuccessApp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pick, useT } from '../i18n';
import { absUrl, href } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const dict = pick(lang, [
  'success.',
  'receipt.',
  'status.',
  'order.summary.',
  'site.name',
  'site.error.generic',
]);
---

<BaseLayout lang={lang} title={t('success.title')} description={t('success.thanks')} noindex>
  <section class="container-page pt-12 pb-10 md:pt-16">
    <div class="prose-page">
      <h1 class="page-title">✓ {t('success.title')}</h1>
      <p class="mt-2 text-lg">{t('success.thanks')}</p>
      <SuccessApp
        client:load
        lang={lang}
        dict={dict}
        trackHref={href(lang, '/track/')}
        trackAbsUrl={absUrl(href(lang, '/track/'))}
      />
    </div>
  </section>
</BaseLayout>
