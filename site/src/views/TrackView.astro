---
import type { Lang } from '@shared/constants';
import TrackApp from '../islands/track/TrackApp';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pick, useT } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const dict = pick(lang, ['track.', 'status.']);
---

<BaseLayout lang={lang} title={t('track.title')} description={t('track.intro')}>
  <section class="container-page pt-12 pb-10 md:pt-16">
    <h1 class="page-title">{t('track.title')}</h1>
    <p class="mt-2 max-w-prose text-lg text-ink-soft">{t('track.intro')}</p>
    <div class="mt-6">
      <TrackApp client:load lang={lang} dict={dict} />
    </div>
  </section>
</BaseLayout>
