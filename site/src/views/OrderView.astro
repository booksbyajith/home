---
import type { Lang } from '@shared/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useT } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('order.title')} description={t('order.payment.instructions')}>
  <section class="container-page py-10">
    <h1 class="text-3xl font-bold">{t('order.title')}</h1>
    <p class="mt-2 text-lg text-ink-soft">{t('order.payment.instructions')}</p>
  </section>
</BaseLayout>
