---
import type { Lang } from '@shared/constants';
import OrderApp, { type OrderBook } from '../islands/order/OrderApp';
import BaseLayout from '../layouts/BaseLayout.astro';
import HowToOrder from '../components/HowToOrder.astro';
import { pick, useT } from '../i18n';
import { getBooks } from '../lib/content';
import { img } from '../lib/images';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';
import { asset, href } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const books: OrderBook[] = (await getBooks()).map((b) => {
  const front = b.covers.find((c) => c.kind === 'front')!;
  const i = img(`/covers/${front.file}`);
  const small = i.srcset?.split(',')[0]?.trim().split(' ')[0] ?? i.src;
  const { externalUrl: _x, ...defaults } = b.defaults;
  return { slug: b.slug, title: b.title, cover: small, defaults };
});
// Commercial Bank's logo, if one has been added as site/public/icons/bank-logo.(svg|png|jpg|webp).
let bankLogo: string | undefined;
try {
  const f = readdirSync(join(process.cwd(), 'public/icons')).find((n) =>
    /^bank-logo\.(svg|png|jpe?g|webp)$/i.test(n),
  );
  if (f) bankLogo = asset(`/icons/${f}`);
} catch {
  /* no icons folder */
}
const dict = pick(lang, ['order.', 'books.', 'site.copy', 'site.copied', 'nav.contact']);
---

<BaseLayout lang={lang} title={t('order.title')} description={t('order.payment.instructions')}>
  <section class="container-page pt-12 pb-10 md:pt-16">
    <h1 class="page-title">{t('order.title')}</h1>
    <HowToOrder lang={lang} />
    <div class="mt-6">
      <OrderApp
        client:load
        lang={lang}
        dict={dict}
        books={books}
        successHref={href(lang, '/order/success/')}
        privacyHref={href(lang, '/privacy/')}
        contactHref={href(lang, '/contact/')}
        bankLogo={bankLogo}
      />
    </div>
  </section>
</BaseLayout>
