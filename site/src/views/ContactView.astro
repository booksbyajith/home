---
import type { Lang } from '@shared/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useT } from '../i18n';
import { href } from '../lib/paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.intro')}>
  <section class="container-page py-10">
    <div class="prose-page">
      <h1 class="text-3xl font-bold">{t('contact.title')}</h1>
      <p class="mt-3 text-lg">{t('contact.intro')}</p>
      <ul class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <li data-config-wrap hidden>
          <a href="#" data-config="whatsapp" hidden class="btn-primary" target="_blank" rel="noopener">
            {t('contact.whatsapp')}
          </a>
        </li>
        <li data-config-wrap hidden>
          <a href="#" data-config="facebook" hidden class="btn-secondary" target="_blank" rel="noopener">
            {t('contact.facebook')}
          </a>
        </li>
        <li data-config-wrap hidden>
          <a href="#" data-config="phone" hidden class="btn-secondary">
            {t('contact.phone')} <span data-phone-label></span>
          </a>
        </li>
      </ul>
      <p class="mt-4 text-ink-soft">{t('contact.hours')}</p>
      <p class="mt-8">
        <a href={href(lang, '/faq/')}>{t('faq.title')}</a> ·{' '}
        <a href={href(lang, '/bulk-orders/')}>{t('nav.bulk')}</a> ·
        <a href={href(lang, '/track/')}>{t('nav.track')}</a>
      </p>
    </div>
  </section>
</BaseLayout>
