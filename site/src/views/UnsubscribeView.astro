---
import type { Lang } from '@shared/constants';
import Unsubscribe from '../islands/forms/Unsubscribe';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pick, useT } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const dict = pick(lang, ['newsletter.unsub.', 'site.loading', 'site.error.generic']);
---

<BaseLayout lang={lang} title={t('newsletter.unsub.title')} description={t('newsletter.unsub.title')} noindex>
  <section class="container-page pt-12 pb-10 md:pt-16">
    <h1 class="page-title">{t('newsletter.unsub.title')}</h1>
    <Unsubscribe client:load dict={dict} />
  </section>
</BaseLayout>
