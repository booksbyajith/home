---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { href } from '../lib/paths';
---

<BaseLayout
  lang="si"
  title={t('si', 'notFound.title')}
  description={t('si', 'notFound.body')}
  noindex
  alternates={{ si: null, en: null, ta: null }}
  fallbackPath="/"
>
  <section class="container-page pt-16 pb-12 text-center md:pt-24">
    <h1 class="page-title">{t('si', 'notFound.title')}</h1>
    <p class="mt-3 text-lg">{t('si', 'notFound.body')}</p>
    <p class="mt-6">
      <a class="btn-primary" href={href('si', '/')}>
        {t('si', 'notFound.home')}
      </a>
    </p>
    {(['en', 'ta'] as const).map((l) => (
      <div lang={l} class="mt-12 border-t border-line pt-10">
        <h2 class="display-md">{t(l, 'notFound.title')}</h2>
        <p class="mt-3">{t(l, 'notFound.body')}</p>
        <p class="mt-6">
          <a class="btn-secondary" href={href(l, '/')}>
            {t(l, 'notFound.home')}
          </a>
        </p>
      </div>
    ))}
  </section>
</BaseLayout>
