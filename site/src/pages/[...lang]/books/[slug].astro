---
import { langParam } from '../../../lib/paths';
import BookView from '../../../views/BookView.astro';
import { getBooks } from '../../../lib/content';
import { LANGS } from '../../../lib/paths';

export async function getStaticPaths() {
  const books = await getBooks();
  return LANGS.flatMap((lang) =>
    books.map((book) => ({
      params: { lang: langParam(lang), slug: book.slug },
      props: { lang, book },
    })),
  );
}
const { lang, book } = Astro.props;
---

<BookView lang={lang} book={book} />
