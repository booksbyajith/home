---
import { langParam } from '../../../../lib/paths';
import PostListView from '../../../../views/PostListView.astro';
import { getPosts } from '../../../../lib/content';
import { LANGS } from '../../../../lib/paths';

export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS) {
    const tags = new Set((await getPosts('blog', lang)).flatMap((p) => p.data.tags));
    for (const tag of tags) out.push({ params: { lang: langParam(lang), tag }, props: { lang, tag } });
  }
  return out;
}
const { lang, tag } = Astro.props;
---

<PostListView lang={lang} kind="blog" tag={tag} />
