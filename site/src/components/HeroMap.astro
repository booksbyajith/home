---
// Antique-style map of Sri Lanka that draws itself in: coastline ink first, then the
// compass rose, rhumb lines, waves and labels. Decorative only.
// Each part is its own layer so fading and spinning stay on the GPU and only the
// coastline repaints while it is drawn.
import { MAP } from '../lib/mapData';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const [cx, cy] = MAP.compassCenter;
// The compass and its rhumb lines sit in the open sea, south-west of the island
// (see .l-compass below for the matching position).
const dx = -470;
const dy = 560;
const R = 95;
const view = `0 0 ${MAP.width} ${MAP.height}`;
---

<div class:list={['hero-map', className]} aria-hidden="true">
  <svg viewBox={view} class="layer l-grat" fill="none" stroke="currentColor">
    <path d={MAP.graticule} stroke-width="0.7" stroke-dasharray="2 7"></path>
  </svg>
  <svg viewBox={view} class="layer l-rhumb" fill="none" stroke="currentColor">
    <path transform={`translate(${dx} ${dy})`} d={MAP.rhumbs} stroke-width="0.6"></path>
  </svg>
  <svg viewBox={view} class="layer l-sea" fill="none" stroke="currentColor" stroke-linecap="round">
    <path d={MAP.waves} stroke-width="1.1"></path>
    <path d={MAP.ship} stroke-width="1.6" stroke-linejoin="round"></path>
  </svg>
  <svg viewBox={view} class="layer l-land" fill="none" stroke="currentColor" stroke-linejoin="round">
    <path class="m-land" d={MAP.coast} pathLength="1" stroke-width="2.4"></path>
    <path class="m-land m-land-2" d={MAP.mannar} pathLength="1" stroke-width="1.8"></path>
  </svg>
  <svg viewBox={view} class="layer l-detail" fill="none" stroke="currentColor">
    <path d={MAP.coastInner} stroke-width="0.9" stroke-dasharray="1 5"></path>
    <text
      x="300"
      y="560"
      fill="currentColor"
      stroke="none"
      font-family="Georgia, serif"
      font-style="italic"
      font-size="28"
      letter-spacing="7"
      transform="rotate(-64 300 560)"
    >
      TAPROBANA
    </text>
  </svg>
  <svg viewBox={`${cx - R} ${cy - R} ${2 * R} ${2 * R}`} class="l-compass" fill="none" stroke="currentColor">
    <circle cx={cx} cy={cy} r="70" stroke-width="1"></circle>
    <circle cx={cx} cy={cy} r="77" stroke-width="0.6"></circle>
    <path d={MAP.compass} class="m-star" stroke-width="1.3"></path>
    <text
      x={cx - 6}
      y={cy - 82}
      fill="currentColor"
      stroke="none"
      font-size="16"
      font-family="Georgia, serif"
    >
      N
    </text>
  </svg>
</div>

<style>
  .hero-map {
    color: var(--color-maroon);
    aspect-ratio: 760 / 980;
    height: auto;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .l-grat,
  .l-rhumb,
  .l-sea,
  .l-detail,
  .l-compass {
    opacity: 0;
    animation: fade-in 1.4s ease forwards;
  }
  .l-grat {
    animation-duration: 1.2s;
  }
  .l-rhumb {
    animation-delay: 1.5s;
  }
  .l-rhumb path {
    stroke-opacity: 0.55;
  }
  .l-sea {
    animation-delay: 1.9s;
  }
  .l-detail {
    animation-delay: 2.4s;
  }
  /* Compass centre (cx + dx, cy + dy) = (150, 810) in the 760 × 980 map, radius 95. */
  .l-compass {
    position: absolute;
    left: 7.237%;
    top: 72.959%;
    width: 25%;
    height: 19.388%;
    overflow: visible;
    animation: spin-in 1.6s var(--ease-out-soft) 1.2s forwards;
  }
  .m-star {
    fill: var(--color-paper);
  }
  .m-land {
    fill: var(--color-sepia);
    fill-opacity: 0;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation:
      draw 2.4s var(--ease-out-soft) 0.2s forwards,
      land-fill 1s ease 2.2s forwards;
  }
  .m-land-2 {
    animation-delay: 1.4s, 2.3s;
  }
  @keyframes land-fill {
    to {
      fill-opacity: 0.85;
    }
  }
  /* Phones: reveal the island with a GPU-friendly fade and settle instead of redrawing the ink every frame. */
  @media (max-width: 767px) {
    .m-land {
      stroke-dashoffset: 0;
      fill-opacity: 0.85;
      animation: none;
    }
    .l-land {
      opacity: 0;
      animation: map-settle 1.6s var(--ease-out-soft) 0.2s forwards;
    }
  }
  @keyframes map-settle {
    from {
      opacity: 0;
      transform: scale(0.94) rotate(-2deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .l-land {
      opacity: 1;
    }
    .m-land {
      stroke-dashoffset: 0;
      fill-opacity: 0.85;
    }
    .l-grat,
    .l-rhumb,
    .l-sea,
    .l-detail,
    .l-compass {
      opacity: 1;
    }
  }
</style>
