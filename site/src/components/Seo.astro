---
import type { Lang } from '@shared/constants';
import { resolveAlternates, type Alternates } from '../lib/alternates';
import { LANGS, absUrl, asset, href, stripLang } from '../lib/paths';
import { t } from '../i18n';

export interface SeoProps {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'book' | 'profile';
  noindex?: boolean;
  /** Language-neutral path of this page in other languages (null = no counterpart). Default: same path. */
  alternates?: Alternates;
  /** Where the language switcher goes for a language with no counterpart (e.g. the section index). */
  fallbackPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  extraMeta?: { property: string; content: string }[];
}

const {
  lang,
  title,
  description,
  ogImage,
  ogType = 'website',
  noindex = false,
  alternates,
  jsonLd,
  extraMeta = [],
} = Astro.props as SeoProps;
const neutral = stripLang(Astro.url.pathname);
const canonical = absUrl(href(lang, neutral));
const alts = resolveAlternates(lang, neutral, alternates);
const urls = LANGS.filter((l) => alts[l] !== null).map((l) => ({ l, url: absUrl(href(l, alts[l]!)) }));
const xDefault = urls.find((u) => u.l === 'si')?.url;
const OG_LOCALE: Record<Lang, string> = { si: 'si_LK', en: 'en_GB', ta: 'ta_LK' };
const siteName = t(lang, 'site.name');
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
// ?v= changes when the share images are redrawn, so WhatsApp and Facebook fetch the new ones.
const OG_VERSION = '2';
const image = `${absUrl(ogImage ?? asset(`/og/default-${lang}.jpg`))}?v=${OG_VERSION}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{urls.map((u) => (
  <link rel="alternate" hreflang={u.l} href={u.url} />
))}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LANGS.filter((l) => l !== lang).map((l) => (
  <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
))}
{extraMeta.map((m) => (
  <meta property={m.property} content={m.content} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{ld.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />
))}
