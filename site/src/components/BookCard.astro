---
import { l10nText as tl } from '@shared/l10n';
import type { Lang } from '@shared/constants';
import { useT } from '../i18n';
import type { BookFacts } from '../lib/content';
import { href } from '../lib/paths';
import BookStatus from './BookStatus.astro';
import Cover from './Cover.astro';

interface Props {
  lang: Lang;
  book: BookFacts;
  summary?: string;
}
const { lang, book, summary } = Astro.props;
const t = useT(lang);
const front = book.covers.find((c) => c.kind === 'front')!;
const url = href(lang, `/books/${book.slug}/`);
---

<article class="card card-hover group flex flex-col gap-5 p-5 sm:flex-row sm:p-6">
  <a href={url} class="block w-40 shrink-0 self-center sm:self-start" tabindex="-1" aria-hidden="true">
    <Cover
      path={`/covers/${front.file}`}
      alt=""
      sizes="160px"
      class="rounded-md shadow-lg transition-transform duration-500 group-hover:-rotate-2"
    />
  </a>
  <div class="flex flex-1 flex-col gap-2">
    <h2 class="text-2xl leading-snug" lang={tl(book.title, lang) === book.title.si ? 'si' : lang}>
      <a href={url} class="text-ink no-underline hover:text-maroon">
        {tl(book.title, lang)}
      </a>
    </h2>
    {book.awards.length > 0 && (
      <p class="badge self-start bg-gold/15 text-ink">🏅 {tl(book.awards[0], lang)}</p>
    )}
    {summary && <p class="text-ink-soft">{summary}</p>}
    <BookStatus lang={lang} book={book} compact />
  </div>
</article>
