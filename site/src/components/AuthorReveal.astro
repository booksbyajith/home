---
// Halftone portrait over the self-drawing map. Moving the pointer towards the face
// uncovers handwritten notes (places and dates from the books) and a hidden line of
// text. On touch screens the notes appear on their own once the map has drawn.
import type { Lang } from '@shared/constants';
import { useT } from '../i18n';
import Cover from './Cover.astro';
import HeroMap from './HeroMap.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const notes = t('home.hero.notes').split('|');
---

<div class="author-reveal relative mx-auto w-full max-w-[560px]" data-author-reveal>
  <HeroMap class="absolute -top-[6%] -left-[10%] w-[88%]" />
  <div class="portrait-wrap relative mx-auto w-[82%]">
    <div class="portrait relative" data-face-x="0.535" data-face-y="0.38">
      <Cover
        path="/author/author-halftone.webp"
        alt={t('pressKit.photo')}
        priority
        sizes="(min-width: 1024px) 460px, 80vw"
        class="portrait-img relative z-[1] w-full select-none"
      />
    </div>
    <div class="notes pointer-events-none absolute inset-0 z-[2]" aria-hidden="true">
      {notes.map((n, i) => (
        <span class:list={['note', `note-${i + 1}`]}>{n}</span>
      ))}
    </div>
  </div>
  <p class="secret relative z-[2] mt-2 text-center font-serif text-xl text-maroon italic sm:text-2xl">
    {t('home.hero.secret')}
  </p>
</div>

<style>
  .author-reveal {
    --mx: -999px;
    --my: -999px;
    --near: 0;
  }
  /* Movement only (no fade), so the portrait counts as painted straight away. */
  .portrait {
    animation: rise 1.2s var(--ease-out-soft) 0.3s both;
  }
  .portrait-img {
    filter: sepia(0.35) saturate(0.9) contrast(1.02);
    transition: filter 0.6s ease;
  }
  .author-reveal[data-near='true'] .portrait-img {
    filter: sepia(0) saturate(1) contrast(1.05);
  }
  .notes {
    /* Only the area around the pointer is uncovered. */
    mask-image: radial-gradient(circle 300px at var(--mx) var(--my), #000 40%, transparent 100%);
    opacity: var(--near);
    transition: opacity 0.4s ease;
  }
  .note {
    position: absolute;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    color: var(--color-maroon-dark);
    white-space: nowrap;
    padding: 0.1rem 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 70%, transparent);
    background: color-mix(in srgb, var(--color-paper) 70%, transparent);
    border-radius: 4px;
  }
  .note-1 {
    top: 3%;
    left: 2%;
    rotate: -6deg;
  }
  .note-2 {
    top: 0%;
    right: 4%;
    rotate: 5deg;
  }
  .note-3 {
    top: 21%;
    left: -4%;
    rotate: -3deg;
  }
  .note-4 {
    top: 19%;
    right: -2%;
    rotate: 4deg;
  }
  .note-5 {
    top: 40%;
    left: 0%;
    rotate: 3deg;
  }
  .note-6 {
    top: 38%;
    right: 0%;
    rotate: -5deg;
  }
  .secret {
    opacity: clamp(0, calc((var(--near) - 0.45) * 2.2), 1);
    translate: 0 calc((1 - var(--near)) * 10px);
    transition:
      opacity 0.4s ease,
      translate 0.4s ease;
  }
  /* Touch screens: no pointer to follow, so the notes and the hidden line appear on their own. */
  @media (hover: none) {
    .notes {
      mask-image: none;
      opacity: 0;
      animation: fade-in 1.2s ease 3s forwards;
    }
    .secret {
      opacity: 0;
      translate: none;
      animation: fade-in 1s ease 3.8s forwards;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .notes,
    .secret {
      opacity: 1;
    }
  }
</style>

<script>
  import { initAuthorReveal } from '../lib/authorReveal';
  document.querySelectorAll<HTMLElement>('[data-author-reveal]').forEach(initAuthorReveal);
</script>
