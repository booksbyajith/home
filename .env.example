# Public, build-time configuration for the site. Copy to .env for a local production-style build.
SITE_URL=https://example.com/site
PUBLIC_USE_EMULATORS=false
PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
PUBLIC_FIREBASE_APP_ID=1:000000000000:web:000000
PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
PUBLIC_APPCHECK_DEBUG_TOKEN=
PUBLIC_FUNCTIONS_REGION=asia-south1
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_META_PIXEL_ID=
